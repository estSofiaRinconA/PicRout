# Configuración de PicRout - Backend
# Copia este archivo como .env y completa los valores

# Aplicación
APP_NAME=PicRout
APP_VERSION=0.1.0
DEBUG=True
SECRET_KEY=cambia_esta_clave_por_una_muy_segura_y_larga

# Base de datos
# Local (SQLite):
DATABASE_URL=sqlite:///./app_routines.db
# Supabase (PostgreSQL) — descomenta y rellena (recomendado para equipo/prod):
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Alternativa conexión directa:
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# OTP (recuperación de contraseña)
OTP_EXPIRE_MINUTES=10

# Correo (para envío de OTP) - configurar después
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@picrout.app

# Almacenamiento de fotos

# Administradores (emails separados por coma)
ADMIN_EMAILS=admin@picrout.app

# =============================================================================
# IA – opciones GRATIS primero
# Sin ninguna key → heurísticas locales (0 coste, offline).
# =============================================================================
AI_USE_LLM=True

# Verificación por fotos (single_photo / before_after).
# False = desactivada temporalmente (ERR-002). Solo quiz activo.

# 1) RECOMENDADO GRATIS: Groq (sin tarjeta)
#    Crear key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 2) Alternativa GRATIS: Google Gemini (AI Studio)
#    Crear key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3) Opcional de pago: xAI / Grok
#    https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4
