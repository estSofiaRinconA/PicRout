# Configuración general
APP_NAME=PicRout
APP_ENV=development
DEBUG=True

# Base de datos
DATABASE_URL=sqlite:///./app_routines.db

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-muy-segura-y-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP (recuperación de contraseña)
OTP_EXPIRE_MINUTES=10

# Correo (para enviar el código OTP) - se configura después
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=True
MAIL_SSL=False